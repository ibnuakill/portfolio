---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import SkillTag from '../components/SkillTag.astro';
import { skills, skillCategories } from '../data/skills';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/helpers';

const projects = (await getCollection('projects')).filter(p => !p.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = projects.filter(p => p.data.featured).slice(0, 3);
const allProjects = projects.slice(0, 6);

const blogPosts = (await getCollection('blog')).filter(p => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = blogPosts.slice(0, 3);
---

<Layout title="Beranda" description={site.description} currentPath="/">
  <section class="hero section" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-content">
        <p class="hero-greeting">Halo, saya</p>
        <h1 id="hero-title" class="hero-title">{site.name}</h1>
        <p class="hero-description">{site.description}</p>
        <div class="hero-actions">
          <a href="/projects" class="btn btn-primary">Lihat Project</a>
          <a href="/contact" class="btn btn-secondary">Hubungi Saya</a>
        </div>
        <div class="hero-social" role="list" aria-label="Social links">
          <a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="GitHub" role="listitem">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" role="listitem">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://twitter.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="Twitter" role="listitem">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  {featuredProjects.length > 0 && (
    <section class="section" aria-labelledby="featured-title">
      <div class="container">
        <header class="section-header">
          <h2 id="featured-title" class="section-title">Project Unggulan</h2>
          <p class="section-description">Beberapa project terbaik yang telah saya kerjakan</p>
        </header>
        <div class="grid grid-3">
          {featuredProjects.map(project => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              tags={project.data.tags}
              demoUrl={project.data.demoUrl}
              repoUrl={project.data.repoUrl}
              featured={true}
            />
          ))}
        </div>
        <div class="section-cta">
          <a href="/projects" class="btn btn-secondary">Lihat Semua Project</a>
        </div>
      </div>
    </section>
  )}
  
  <section class="section" aria-labelledby="skills-title">
    <div class="container">
      <header class="section-header">
        <h2 id="skills-title" class="section-title">Keahlian</h2>
        <p class="section-description">Teknologi dan tools yang saya kuasai</p>
      </header>
      <div class="skills-categories">
        {skillCategories.map(category => (
          <div class="skill-category">
            <h3 class="skill-category-title">{category}</h3>
            <div class="skill-tags" role="list" aria-label={`${category} skills`}>
              {skills.filter(s => s.category === category).map(skill => (
                <SkillTag name={skill.name} category={skill.category} level={skill.level} role="listitem" />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  {latestPosts.length > 0 && (
    <section class="section" aria-labelledby="blog-title">
      <div class="container">
        <header class="section-header">
          <h2 id="blog-title" class="section-title">Artikel Terbaru</h2>
          <p class="section-description">Tulisan terbaru seputar pengembangan web dan teknologi</p>
        </header>
        <div class="grid grid-3">
          {latestPosts.map((post) => (
            <BlogPostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              slug={post.id}
            />
          ))}
        </div>
        <div class="section-cta">
          <a href="/blog" class="btn btn-secondary">Baca Semua Artikel</a>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .hero {
    padding: 6rem 0 4rem;
    text-align: center;
  }
  
  .hero-greeting {
    font-size: 1.25rem;
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: 1rem;
    display: block;
  }
  
  .hero-title {
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .hero-description {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }
  
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  
  .hero-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  
  .hero-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    transition: all var(--transition);
  }
  
  .hero-social a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }
  
  .section-cta {
    text-align: center;
    margin-top: 2.5rem;
  }
  
  .skills-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .skill-category-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 3rem;
    }
    
    .hero-title {
      font-size: clamp(2rem, 8vw, 3rem);
    }
    
    .hero-description {
      font-size: 1.125rem;
    }
  }
</style>