---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import SkillTag from '../components/SkillTag.astro';
import ParticleImage from '../components/originkit/svgparticles';
import { skills, skillCategories } from '../data/skills';
import { site } from '../data/site';
import { social } from '../data/social';
import { hero } from '../data/hero';
import { getCollection } from 'astro:content';
import { getGithubProjects } from '../utils/github';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjectsManual = projects.filter(p => p.data.featured).slice(0, 3);
const githubProjects = await getGithubProjects(3);
const githubUrls = new Set(githubProjects.map(g => g.repoUrl));
const featuredProjects = [...featuredProjectsManual.filter(p => !githubUrls.has(p.data.repoUrl!)), ...githubProjects.map(g => ({ data: { ...g, featured:true }, id: g.repoUrl }))].slice(0,3);

const blogPosts = (await getCollection('blog')).filter(p => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = blogPosts.slice(0, 3);



const icons = {
  'map-pin': '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle>',
  'cpu': '<path d="M12 20v2"></path><path d="M12 2v2"></path><path d="M17 20v2"></path><path d="M17 2v2"></path><path d="M2 12h2"></path><path d="M2 17h2"></path><path d="M2 7h2"></path><path d="M20 12h2"></path><path d="M20 17h2"></path><path d="M20 7h2"></path><path d="M7 20v2"></path><path d="M7 2v2"></path><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="8" y="8" width="8" height="8" rx="1"></rect>',
  'check': '<path d="M20 6 9 17l-5-5"></path>',
};
---

<Layout title="Beranda" description={site.description} currentPath="/">
  <section class="mx-auto w-full max-w-[1280px] px-2 sm:px-3 mt-2" aria-labelledby="hero-title">
    <div class="hero-card relative overflow-hidden rounded-[20px] sm:rounded-[28px] bg-[#0a0a0f] border border-white/10 min-h-[calc(100dvh-72px)] flex flex-col">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.07)_1px,transparent_1px)] bg-[size:40px_40px] opacity-[0.5] pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 h-[46%] bg-gradient-to-t from-[#1e3aff]/20 via-[#1e3aff]/10 to-transparent pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-white/[0.02] via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 flex flex-1 flex-col p-5 sm:p-7 lg:p-8 pointer-events-none">
        <div class="flex justify-between items-start gap-4">
          <div class="hero-reveal pointer-events-none">
            <h1 id="hero-title" class="font-black tracking-tighter leading-[0.85] text-white" style="font-family: var(--font-effra)">
              <span class="block text-[11vw] sm:text-6xl lg:text-[76px] font-black italic tracking-tight" style="font-family: var(--font-effra)">I'M</span>
              <span class="block text-[11vw] sm:text-6xl lg:text-[76px]" style="font-family: var(--font-effra)">IBNU AKIL</span>
            </h1>
            <a href={hero.primaryCta.href} class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#1e3aff] text-white px-5 py-2.5 text-sm font-medium hover:bg-[#1e3aff]/90 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e3aff] pointer-events-auto">
              <span>{hero.primaryCta.label}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
          <div class="hidden sm:flex flex-col items-end gap-2 text-right shrink-0 pointer-events-none">
            <p class="text-sm font-semibold text-white">Follow Me</p>
            <div class="flex gap-1.5 pointer-events-auto">
              <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub" class="w-7 h-7 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-white/70 hover:bg-white hover:text-black transition-colors">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8a9.56 9.56 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
              </a>
              <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="w-7 h-7 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-white/70 hover:bg-white hover:text-black transition-colors text-[10px] font-bold">in</a>
              <a href={social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-7 h-7 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-white/70 hover:bg-white hover:text-black transition-colors">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-2.21 0-4 1.79-4 4v3H7v4h3v5h4v-5h3l1-4h-4V8c0-.55.45-1 1-1z"/></svg>
              </a>
              <a href={social.email} aria-label="Email" class="w-7 h-7 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-white/70 hover:bg-white hover:text-black transition-colors">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 8.5 6.5a2 2 0 0 0 2.4 0L22 7"/></svg>
              </a>
            </div>
            <p class="max-w-[250px] text-xs leading-relaxed text-white/50 text-right">I design intuitive interface and develop user-centric web experiences</p>
          </div>
        </div>

        <div class="absolute left-1/2 -translate-x-1/2 bottom-0 w-[380px] sm:w-[460px] lg:w-[560px] h-[500px] sm:h-[580px] lg:h-[620px] z-[1] flex items-end justify-center pointer-events-none hidden motion-safe:flex" aria-hidden="true">
          <ParticleImage
            client:media="(prefers-reduced-motion: no-preference)"
            width="100%"
            height="100%"
            particleCount={88}
            particleSize={3}
            imageConfig={{ image: hero.photo.src, mode: 'fit', scale: 13 }}
            hoverConfig={{ hoverType: 'roam', roamOpacity: 0.5, transition: { duration: 0.9, ease: 'easeInOut' } }}
            repulsionConfig={{ repulsionForce: 4, repulsionRadius: 50 }}
          />
        </div>
        <div class="absolute left-1/2 -translate-x-1/2 bottom-0 w-[380px] sm:w-[460px] lg:w-[560px] h-[500px] sm:h-[580px] lg:h-[620px] z-[1] flex items-end justify-center pointer-events-none motion-safe:hidden" aria-hidden="true">
          <img src={hero.photo.src} alt={hero.photo.alt} width="560" height="620" class="w-full h-full object-cover object-top" style="mask-image: linear-gradient(to bottom, black 82%, transparent 100%)" />
        </div>
        <div id="hero-hover-capture" class="absolute inset-0 z-[2] hidden motion-safe:block pointer-events-auto" aria-hidden="true"></div>

        <div class="mt-auto flex flex-col lg:flex-row justify-between items-start lg:items-end gap-5 relative z-10 pt-6 pointer-events-none">
          <p class="max-w-[340px] text-[13px] sm:text-sm leading-relaxed text-white/60">
            Hello, I'm Ibnu Akil, a Web Developer passionate about creating meaningful digital experiences.
            <span class="hidden sm:inline"> {hero.tagline}</span>
          </p>
          <p class="text-right font-black tracking-tighter leading-[0.85] text-white text-[28px] sm:text-[34px] lg:text-[46px]">
            <span class="block">WEB</span>
            <span class="block">DEVELOPER</span>
          </p>
        </div>

        <div class="sm:hidden mt-4 flex items-center gap-2 relative z-10 pointer-events-none">
          <span class="text-xs font-semibold text-white">Follow Me</span>
          <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub" class="w-7 h-7 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-white"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8a9.56 9.56 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg></a>
          <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="w-7 h-7 rounded-full bg-white/10 grid place-items-center text-[10px] font-bold text-white">in</a>
          <a href={social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-white"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3c-2.21 0-4 1.79-4 4v3H7v4h3v5h4v-5h3l1-4h-4V8c0-.55.45-1 1-1z"/></svg></a>
          <a href={social.email} aria-label="Email" class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-white"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 8.5 6.5a2 2 0 0 0 2.4 0L22 7"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="py-20" aria-labelledby="featured-title">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
        <header class="mb-12 text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] backdrop-blur-md px-3 py-1 text-xs text-muted mb-3"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Auto-sync GitHub • ibnuakill</div>
          <h2 id="featured-title" class="mb-2 text-3xl font-semibold sm:text-4xl">Project Unggulan</h2>
        </header>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map(project => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              tags={project.data.tags}
              demoUrl={project.data.demoUrl}
              repoUrl={project.data.repoUrl}
              featured={true}
            />
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/projects" class="inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-colors duration-200 hover:bg-line motion-reduce:transition-none">Lihat Semua Project →</a>
        </div>
      </div>
    </section>
  )}

  <section class="relative py-20 overflow-hidden" aria-labelledby="skills-title">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-[radial-gradient(ellipse_at_center,rgba(59,130,246,0.08),transparent_70%)] blur-3xl"></div>
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-[radial-gradient(ellipse_at_center,rgba(139,92,246,0.06),transparent_70%)] blur-3xl"></div>
    </div>
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <header class="mb-12 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] backdrop-blur-md px-4 py-1.5 text-xs font-medium tracking-wide text-muted mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)] animate-pulse" aria-hidden="true"></span>
          Tech Stack
        </div>
        <h2 id="skills-title" class="mb-3 text-3xl font-semibold tracking-tight sm:text-4xl text-ink">Keahlian</h2>
        <p class="mx-auto max-w-[600px] text-muted leading-relaxed">Kumpulan teknologi dan tools yang saya gunakan untuk membangun produk yang cepat dan andal</p>
      </header>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {skillCategories.map(category => {
          const catIcons = {
            Frontend: '<path d="M2 16 8 8 2 2"/><path d="M9 8h6"/><path d="M15 2v12"/><rect x="2" y="16" width="20" height="4" rx="1"/>',
            Backend: '<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01"/><path d="M6 18h.01"/>',
            Language: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M10 13a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1h1"/><path d="M14 18v-3a1 1 0 0 0-1-1h-1"/>',
            Database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
            Styling: '<circle cx="12" cy="12" r="10"/><path d="M12 2a7 7 0 0 1 7 7c0 2.1-1.2 3.9-3 4.8"/><path d="M12 2v4"/><path d="M12 18v4"/>',
            Tools: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
            DevOps: '<path d="M17.5 19H9a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2h.5"/><path d="M17 10a5 5 0 0 0-4.5-5h-.5a5 5 0 0 0-5 5 3 3 0 0 0 3 3h7a3 3 0 0 0 0-6 5 5 0 0 0-5 5"/>',
          };
          const levelDot = { Advanced: 'bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)]', Intermediate: 'bg-amber-400 shadow-[0_0_6px_rgba(251,146,60,0.7)]', Beginner: 'bg-sky-400 shadow-[0_0_6px_rgba(56,189,248,0.7)]' } as const;
          return (
          <div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] backdrop-blur-xl p-6 shadow-[0_8px_32px_rgba(0,0,0,0.2),inset_0_1px_0_rgba(255,255,255,0.06)] hover:bg-white/[0.07] hover:border-white/15 hover:shadow-[0_12px_40px_rgba(0,0,0,0.3),inset_0_1px_0_rgba(255,255,255,0.08)] transition-all duration-300">
            <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
            <div class="relative">
              <div class="flex items-center gap-3 mb-5">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/[0.06] backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/80" aria-hidden="true"><Fragment set:html={(catIcons as Record<string,string>)[category] ?? (catIcons as Record<string,string>)['Tools']} /></svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold tracking-wide text-ink uppercase">{category}</h3>
                  <p class="text-xs text-muted">{skills.filter(s=>s.category===category).length} skills</p>
                </div>
              </div>
              <div class="flex flex-wrap gap-2.5" role="list" aria-label={`${category} skills`}>
                {skills.filter(s => s.category === category).map(skill => (
                  <span class="group/skill inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.06] backdrop-blur-md px-3.5 py-1.5 text-sm font-medium text-white/90 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] hover:bg-white/10 hover:border-white/15 hover:text-white transition-all duration-200" role="listitem">
                    <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${(levelDot as Record<string,string>)[skill.level ?? 'Intermediate']}`} aria-hidden="true"></span>
                    {skill.name}
                  </span>
                ))}
              </div>
            </div>
          </div>
        )})}
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="py-20" aria-labelledby="blog-title">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
        <header class="mb-12 text-center">
          <h2 id="blog-title" class="mb-2 text-3xl font-semibold sm:text-4xl">Artikel Terbaru</h2>
          <p class="mx-auto max-w-[600px] text-muted">Tulisan terbaru seputar pengembangan web dan teknologi</p>
        </header>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((post) => (
            <BlogPostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              slug={post.id}
            />
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/blog" class="inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-colors duration-200 hover:bg-line motion-reduce:transition-none">Baca Semua Artikel</a>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-reveal > * {
    animation: hero-fade-up 0.6s ease both;
  }

  .hero-reveal > *:nth-child(2) {
    animation-delay: 0.1s;
  }

  .hero {
    isolation: isolate;
  }
</style>

<script>
  const hero = document.querySelector('.hero-card');
  const capture = document.getElementById('hero-hover-capture');
  const canvas = () => document.querySelector('.hero-card canvas');
  if (hero && capture) {
    const fwd = (e: MouseEvent) => {
      const c = canvas();
      if (!c) return;
      const r = c.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      c.dispatchEvent(new MouseEvent('mousemove', { clientX: e.clientX, clientY: e.clientY, bubbles: true }));
      if (x < 0 || x > r.width || y < 0 || y > r.height) {
        c.dispatchEvent(new MouseEvent('mousemove', { clientX: r.left + r.width/2, clientY: r.top + r.height/2, bubbles: true }));
      }
    };
    capture.addEventListener('mousemove', fwd);
    capture.addEventListener('mouseenter', fwd);
    capture.addEventListener('mouseleave', () => {
      const c = canvas();
      if (c) c.dispatchEvent(new MouseEvent('mouseleave', { bubbles: true }));
    });
  }
</script>
