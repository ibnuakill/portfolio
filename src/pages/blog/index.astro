---
import Layout from '../../layouts/Layout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { getAllTags } from '../../utils/helpers';

const allPosts = (await getCollection('blog')).filter(p => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const allTags = getAllTags(allPosts.map(p => p.data));

const { tag, page = '1' } = Astro.url.searchParams;
const currentPage = parseInt(page, 10);
const postsPerPage = 6;
const filteredPosts = tag ? allPosts.filter(p => p.data.tags.includes(tag)) : allPosts;
const totalPages = Math.ceil(filteredPosts.length / postsPerPage);
const paginatedPosts = filteredPosts.slice((currentPage - 1) * postsPerPage, currentPage * postsPerPage);
const activeTag = tag || 'all';

if (currentPage > totalPages && totalPages > 0) {
  return Astro.redirect(`/blog${tag ? `?tag=${tag}` : ''}`);
}

const tagFilterClass = (active: boolean) =>
  `rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-200 motion-reduce:transition-none ${
    active
      ? 'border-accent bg-accent text-white'
      : 'border-line bg-bg text-muted hover:border-accent hover:bg-accent hover:text-white'
  }`;
---

<Layout title="Blog" description="Artikel seputar pengembangan web, teknologi, dan pengalaman belajar" currentPath="/blog">
  <section class="border-b border-line bg-surface px-4 pb-8 pt-12 text-center sm:px-6">
    <div class="mx-auto w-full max-w-6xl">
      <h1 class="mb-3 text-4xl font-semibold sm:text-5xl">Blog</h1>
      <p class="mx-auto max-w-[600px] text-lg text-muted">Tulisan seputar pengembangan web, teknologi, dan pengalaman belajar</p>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      {allTags.length > 0 && (
        <div class="mb-8 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter by tag">
          <a href="/blog" class={tagFilterClass(activeTag === 'all')}>Semua</a>
          {allTags.map(t => (
            <a href={`/blog?tag=${t}`} class={tagFilterClass(activeTag === t)}>{t}</a>
          ))}
        </div>
      )}

      {paginatedPosts.length > 0 ? (
        <>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {paginatedPosts.map(post => (
              <BlogPostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                slug={post.id}
                draft={post.data.draft}
              />
            ))}
          </div>

          {totalPages > 1 && (
            <nav class="mt-12 flex items-center justify-center gap-6 border-t border-line pt-8" aria-label="Pagination">
              {currentPage > 1 && (
                <a href={`/blog?page=${currentPage - 1}${tag ? `&tag=${tag}` : ''}`} class="inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-colors duration-200 hover:bg-line">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                  Sebelumnya
                </a>
              )}
              <span class="text-[0.9375rem] text-muted">Halaman {currentPage} dari {totalPages}</span>
              {currentPage < totalPages && (
                <a href={`/blog?page=${currentPage + 1}${tag ? `&tag=${tag}` : ''}`} class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition-colors duration-200 hover:bg-accent-hover">
                  Selanjutnya
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </a>
              )}
            </nav>
          )}
        </>
      ) : (
        <div class="flex flex-col items-center justify-center px-8 py-16 text-center text-muted">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="mb-4 opacity-50">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          <h3 class="mb-2 text-xl font-semibold text-ink">Tidak ada artikel</h3>
          <p class="mb-6">{tag ? `Tidak ada artikel dengan tag "${tag}"` : 'Belum ada artikel yang dipublikasikan'}</p>
          {tag && <a href="/blog" class="inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-colors duration-200 hover:bg-line">Lihat semua artikel</a>}
        </div>
      )}
    </div>
  </section>
</Layout>
