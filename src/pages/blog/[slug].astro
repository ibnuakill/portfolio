---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime } from '../../utils/helpers';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(p => !p.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readTime = Math.ceil((post.body?.split(/\s+/).length || 0) / 200);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image ? `${site.url}${post.data.image}` : site.ogImage,
  url: `${site.url}/blog/${post.id}`,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: site.author },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/logo.png` } },
  keywords: post.data.tags.join(', '),
  articleSection: 'Technology',
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image || site.ogImage}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString()}
  tags={post.data.tags}
  currentPath="/blog"
  canonicalURL={`${site.url}/blog/${post.id}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <article class="blog-post">
    <header class="blog-header">
      <div class="container">
        <div class="blog-meta">
          <div class="blog-tags" role="list" aria-label="Tag">
            {post.data.tags.map(tag => (
              <a href={`/blog?tag=${tag}`} class="tag" role="listitem">{tag}</a>
            ))}
          </div>
          <time datetime={post.data.pubDate.toISOString()} class="blog-date">
            {formatDate(post.data.pubDate)}
          </time>
          <span class="blog-reading-time" aria-label="Estimasi waktu baca">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            {readTime} min baca
          </span>
        </div>
        <h1 class="blog-title">{post.data.title}</h1>
        <p class="blog-description">{post.data.description}</p>
        
        {post.data.updatedDate && (
          <p class="blog-updated">
            Diperbarui: {formatDate(post.data.updatedDate)}
          </p>
        )}
      </div>
    </header>
    
    {post.data.image && (
      <div class="blog-cover">
        <img src={post.data.image} alt="" loading="eager" />
      </div>
    )}
    
    <div class="blog-content container">
      <div class="blog-body">
        <Content />
      </div>
      
      <footer class="blog-footer">
        <nav class="blog-nav" aria-label="Blog navigation">
          <a href="/blog" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"/>
              <polyline points="12 19 5 12 12 5"/>
            </svg>
            Kembali ke Blog
          </a>
        </nav>
        
        <div class="blog-share" aria-label="Share article">
          <span>Bagikan:</span>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`${site.url}/blog/${post.id}`)}`} target="_blank" rel="noopener noreferrer" class="share-link" aria-label="Share on Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${site.url}/blog/${post.id}`)}`} target="_blank" rel="noopener noreferrer" class="share-link" aria-label="Share on LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href={`https://github.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`${site.url}/blog/${post.id}`)}`} target="_blank" rel="noopener noreferrer" class="share-link" aria-label="Share on GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    padding-top: 0;
  }
  
  .blog-header {
    padding: 4rem 0 2rem;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }
  
  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .blog-tags .tag {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: transparent;
  }
  
  .blog-tags .tag:hover {
    background: var(--color-primary);
    color: white;
  }
  
  .blog-date {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }
  
  .blog-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  
  .blog-title {
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .blog-description {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 800px;
    margin-bottom: 1.5rem;
  }
  
  .blog-updated {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  
  .blog-cover {
    margin: 0 calc(-1 * var(--container-padding));
    max-width: calc(100% + 2 * var(--container-padding));
  }
  
  .blog-cover img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .blog-content {
    padding: 3rem var(--container-padding);
    max-width: var(--max-width);
    margin: 0 auto;
  }
  
  .blog-body {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .blog-body h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  
  .blog-body h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  
  .blog-body h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .blog-body p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }
  
  .blog-body ul, .blog-body ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  
  .blog-body li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  
  .blog-body code {
    font-size: 0.9em;
  }
  
  .blog-body pre {
    margin: 1.5rem 0;
    border-radius: var(--radius-md);
    overflow-x: auto;
  }
  
  .blog-body pre code {
    display: block;
    padding: 1rem;
    overflow-x: auto;
  }
  
  .blog-body blockquote {
    border-left-color: var(--color-primary);
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }
  
  .blog-body img {
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    box-shadow: var(--shadow-md);
  }
  
  .blog-body a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .blog-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    overflow-x: auto;
    display: block;
  }
  
  .blog-body th, .blog-body td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  
  .blog-body th {
    background: var(--color-bg-secondary);
    font-weight: 600;
  }
  
  .blog-body hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }
  
  .blog-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  
  .blog-share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }
  
  .share-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    transition: all var(--transition);
  }
  
  .share-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }
  
  @media (max-width: 768px) {
    .blog-header {
      padding: 3rem 0 1.5rem;
    }
    
    .blog-content {
      padding: 2rem var(--container-padding);
    }
    
    .blog-cover {
      margin: 0 calc(-1 * var(--container-padding));
    }
    
    .blog-footer {
      flex-direction: column;
    }
  }
</style>