---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/helpers';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(p => !p.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readTime = Math.ceil((post.body?.split(/\s+/).length || 0) / 200);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image ? `${site.url}${post.data.image}` : site.ogImage,
  url: `${site.url}/blog/${post.id}`,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: site.author },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/logo.png` } },
  keywords: post.data.tags.join(', '),
  articleSection: 'Technology',
};

const shareLink = 'flex h-10 w-10 items-center justify-center rounded-lg border border-line text-muted transition-[border-color,color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent hover:text-accent motion-reduce:transition-none motion-reduce:hover:translate-y-0';
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image || site.ogImage}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString()}
  tags={post.data.tags}
  currentPath="/blog"
  canonicalURL={`${site.url}/blog/${post.id}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article>
    <header class="border-b border-line bg-surface px-4 pb-8 pt-12 sm:px-6 md:pt-16">
      <div class="mx-auto w-full max-w-6xl">
        <div class="mb-6 flex flex-wrap items-center gap-4">
          <div class="flex flex-wrap gap-2" role="list" aria-label="Tag">
            {post.data.tags.map(tag => (
              <a href={`/blog?tag=${tag}`} class="inline-block rounded-full border border-accent bg-transparent px-3 py-1 text-xs font-medium text-accent transition-colors duration-200 hover:bg-accent hover:text-white" role="listitem">{tag}</a>
            ))}
          </div>
          <time datetime={post.data.pubDate.toISOString()} class="text-[0.9375rem] text-muted">
            {formatDate(post.data.pubDate)}
          </time>
          <span class="inline-flex items-center gap-1.5 text-sm text-muted" aria-label="Estimasi waktu baca">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            {readTime} min baca
          </span>
        </div>
        <h1 class="mb-4 text-3xl font-semibold leading-tight sm:text-5xl">{post.data.title}</h1>
        <p class="mb-6 max-w-[800px] text-xl text-muted">{post.data.description}</p>

        {post.data.updatedDate && (
          <p class="text-sm text-muted">
            Diperbarui: {formatDate(post.data.updatedDate)}
          </p>
        )}
      </div>
    </header>

    {post.data.image && (
      <div>
        <img src={post.data.image} alt="" loading="eager" class="block h-auto w-full" />
      </div>
    )}

    <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 md:py-16">
      <div class="prose prose-invert prose-headings:font-semibold prose-h2:mt-12 prose-h2:border-t prose-h2:border-line prose-h2:pt-4 prose-h3:mt-8 prose-p:leading-loose prose-a:text-accent prose-a:underline prose-a:underline-offset-2 prose-code:rounded prose-code:bg-code prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-pre:border-line prose-pre:bg-code prose-pre:rounded-lg prose-blockquote:border-l-accent prose-img:rounded-lg prose-img:shadow-md prose-th:bg-surface prose-th:font-semibold prose-hr:border-line mx-auto max-w-[800px]">
        <Content />
      </div>

      <footer class="mt-16 flex flex-col items-center gap-8 border-t border-line pt-8 text-center">
        <nav aria-label="Blog navigation">
          <a href="/blog" class="inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-colors duration-200 hover:bg-line">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"/>
              <polyline points="12 19 5 12 12 5"/>
            </svg>
            Kembali ke Blog
          </a>
        </nav>

        <div class="flex items-center gap-3 text-[0.9375rem] text-muted" aria-label="Share article">
          <span>Bagikan:</span>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`${site.url}/blog/${post.id}`)}`} target="_blank" rel="noopener noreferrer" class={shareLink} aria-label="Share on Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${site.url}/blog/${post.id}`)}`} target="_blank" rel="noopener noreferrer" class={shareLink} aria-label="Share on LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href={`https://github.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`${site.url}/blog/${post.id}`)}`} target="_blank" rel="noopener noreferrer" class={shareLink} aria-label="Share on GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </footer>
    </div>
  </article>
</Layout>
