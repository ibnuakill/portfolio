---
import Layout from '../layouts/Layout.astro';
import AboutParticle from '../components/AboutParticle';
import { site } from '../data/site';
---

<Layout title="Tentang Saya" description="Mengenal lebih dekat latar belakang dan pengalaman saya" currentPath="/about">
  <div class="bg-bg text-white overflow-hidden pb-[8%] px-[5%] sm:px-[5%] lg:px-[10%] pt-8 sm:pt-6" id="About">
    <div class="text-center lg:mb-8 mb-6 px-[5%]" data-aos="zoom-in-up" data-aos-duration="600">
      <div class="inline-block relative group">
        <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#068e75] to-[#10b981]">
          About Me
        </h1>
      </div>
      <p class="mt-3 text-white/60 max-w-2xl mx-auto text-base sm:text-lg flex items-center justify-center gap-2" data-aos="zoom-in-up" data-aos-duration="800">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="1.5" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.937A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.582a.5.5 0 0 1 0 .962L15.5 14.063A2 2 0 0 0 14.063 15.5l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v5"/><path d="M5 22H1"/></svg>
        Transforming ideas into digital experiences
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="1.5" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.937A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.582a.5.5 0 0 1 0 .962L15.5 14.063A2 2 0 0 0 14.063 15.5l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v5"/><path d="M5 22H1"/></svg>
      </p>
    </div>

    <div class="w-full mx-auto pt-4 sm:pt-6 relative">
      <div class="flex flex-col-reverse lg:grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="space-y-6 text-center lg:text-left">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold" data-aos="fade-right" data-aos-duration="1000">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#068e75] to-[#10b981]">Hello, I'm</span>
            <span class="block mt-2 text-white" data-aos="fade-right" data-aos-duration="1300">{site.name}</span>
          </h2>
          <p class="text-base sm:text-lg lg:text-xl text-white/60 leading-relaxed text-justify lg:text-left pb-2" data-aos="fade-right" data-aos-duration="1500">
            Saya adalah Web Developer yang berfokus pada pengembangan aplikasi web modern. Saya senang membangun solusi digital yang cepat, rapi, dan mudah digunakan — menggabungkan intuisi produk dengan rekayasa sistem untuk hasil yang andal.
          </p>

          <div class="relative bg-gradient-to-br from-[#068e75]/5 via-transparent to-[#10b981]/5 border border-[#068e75]/20 rounded-2xl p-4 my-6 backdrop-blur-md shadow-2xl overflow-hidden" data-aos="fade-up" data-aos-duration="1700">
            <div class="absolute top-2 right-4 w-16 h-16 bg-gradient-to-r from-[#068e75]/20 to-[#10b981]/20 rounded-full blur-xl"></div>
            <div class="absolute -bottom-4 -left-2 w-12 h-12 bg-gradient-to-r from-[#10b981]/20 to-[#068e75]/20 rounded-full blur-lg"></div>
            <div class="absolute top-3 left-4 text-[#10b981] opacity-30">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/></svg>
            </div>
            <blockquote class="text-white/70 text-center lg:text-left italic font-medium text-sm relative z-10 pl-6">
              "Leveraging AI as a professional tool, not a replacement."
            </blockquote>
          </div>

          <div class="flex flex-col lg:flex-row items-center lg:items-start gap-4 lg:gap-4 w-full">
            <a href="/contact" class="w-full lg:w-auto">
              <button data-aos="fade-up" data-aos-duration="800" class="w-full lg:w-auto px-6 py-3 rounded-lg bg-gradient-to-r from-[#068e75] to-[#10b981] text-white font-medium transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2 shadow-lg hover:shadow-xl">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                Download CV
              </button>
            </a>
            <a href="/projects" class="w-full lg:w-auto">
              <button data-aos="fade-up" data-aos-duration="1000" class="w-full lg:w-auto px-6 py-3 rounded-lg border border-[#10b981]/50 text-[#10b981] font-medium transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2 hover:bg-[#10b981]/10">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                View Projects
              </button>
            </a>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end items-center p-2 sm:p-8">
          <div class="relative" data-aos="fade-up" data-aos-duration="1000">
            <div class="absolute -inset-6 opacity-25 z-0 hidden sm:block">
              <div class="absolute inset-0 bg-gradient-to-r from-[#068e75] via-[#10b981] to-[#34d399] rounded-full blur-2xl animate-spin-slower"></div>
              <div class="absolute inset-0 bg-gradient-to-l from-[#10b981] via-[#34d399] to-[#068e75] rounded-full blur-2xl animate-pulse-slow opacity-50"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[#068e75] via-[#10b981] to-white/20 rounded-full blur-2xl animate-float opacity-40"></div>
            </div>
            <div class="relative w-72 h-72 sm:w-80 sm:h-80 rounded-[2rem] overflow-hidden bg-[#0a0a0f]/50 backdrop-blur border border-white/10 shadow-[0_0_40px_rgba(30,58,255,0.25)]">
              <AboutParticle client:only="react" src="/profile-cut.png" />
              <div class="absolute inset-0 rounded-[2rem] border border-white/10 pointer-events-none"></div>
              <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-[#0a0a0f] to-transparent pointer-events-none"></div>
            </div>
            <p class="mt-3 text-center text-xs text-white/40">Hover untuk menyatukan partikel</p>
          </div>
        </div>
      </div>

      <a href="/projects" class="block">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-14">
          <div data-aos="fade-right" data-aos-duration="1300" class="relative group">
            <div class="relative z-10 bg-white/[0.04] backdrop-blur-lg rounded-2xl p-6 border border-white/10 overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-2xl h-full flex flex-col justify-between">
              <div class="absolute -z-10 inset-0 bg-gradient-to-br from-[#068e75] to-[#10b981] opacity-10 group-hover:opacity-20 transition-opacity"></div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-14 h-14 rounded-full flex items-center justify-center bg-white/10 group-hover:rotate-6 transition-transform">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <span class="text-3xl font-bold text-white" data-aos="fade-up-left" data-aos-duration="1500">15+</span>
              </div>
              <div>
                <p class="text-sm uppercase tracking-wider text-white/70 mb-1" data-aos="fade-up" data-aos-duration="800">Total Projects</p>
                <div class="flex items-center justify-between">
                  <p class="text-xs text-white/50" data-aos="fade-up" data-aos-duration="1000">Innovative web solutions crafted</p>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-opacity="0.5" stroke-width="2" class="group-hover:stroke-white transition-colors" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </div>
              </div>
            </div>
          </div>
          <div data-aos="fade-up" data-aos-duration="1300" class="relative group">
            <div class="relative z-10 bg-white/[0.04] backdrop-blur-lg rounded-2xl p-6 border border-white/10 overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-2xl h-full flex flex-col justify-between">
              <div class="absolute -z-10 inset-0 bg-gradient-to-br from-[#10b981] to-[#068e75] opacity-10 group-hover:opacity-20 transition-opacity"></div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-14 h-14 rounded-full flex items-center justify-center bg-white/10 group-hover:rotate-6 transition-transform">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/><path d="M16 8a4 4 0 0 1-4 4"/></svg>
                </div>
                <span class="text-3xl font-bold text-white" data-aos="fade-up-left" data-aos-duration="1500">10</span>
              </div>
              <div>
                <p class="text-sm uppercase tracking-wider text-white/70 mb-1" data-aos="fade-up" data-aos-duration="800">Certificates</p>
                <div class="flex items-center justify-between">
                  <p class="text-xs text-white/50" data-aos="fade-up" data-aos-duration="1000">Professional skills validated</p>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-opacity="0.5" stroke-width="2" class="group-hover:stroke-white transition-colors" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </div>
              </div>
            </div>
          </div>
          <div data-aos="fade-left" data-aos-duration="1300" class="relative group">
            <div class="relative z-10 bg-white/[0.04] backdrop-blur-lg rounded-2xl p-6 border border-white/10 overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-2xl h-full flex flex-col justify-between">
              <div class="absolute -z-10 inset-0 bg-gradient-to-br from-[#068e75] to-[#10b981] opacity-10 group-hover:opacity-20 transition-opacity"></div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-14 h-14 rounded-full flex items-center justify-center bg-white/10 group-hover:rotate-6 transition-transform">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/><path d="M16 13a5 5 0 0 0-5-5"/></svg>
                </div>
                <span class="text-3xl font-bold text-white" data-aos="fade-up-left" data-aos-duration="1500">3+</span>
              </div>
              <div>
                <p class="text-sm uppercase tracking-wider text-white/70 mb-1" data-aos="fade-up" data-aos-duration="800">Years of Experience</p>
                <div class="flex items-center justify-between">
                  <p class="text-xs text-white/50" data-aos="fade-up" data-aos-duration="1000">Continuous learning journey</p>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-opacity="0.5" stroke-width="2" class="group-hover:stroke-white transition-colors" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <style>
    @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
    @keyframes spin-slower { to{transform:rotate(360deg)} }
    .animate-float{animation:float 6s ease-in-out infinite}
    .animate-spin-slower{animation:spin-slower 8s linear infinite}
    .animate-pulse-slow{animation:pulse 3s infinite}
  </style>
  <script>
    import AOS from "aos";
    import "aos/dist/aos.css";
    AOS.init({ once: false, offset: 10 });
  </script>
</Layout>
