---
import Layout from '../layouts/Layout.astro';
import SkillTag from '../components/SkillTag.astro';
import { skills, skillCategories } from '../data/skills';
import { site } from '../data/site';
---

<Layout title="Tentang Saya" description="Mengenal lebih dekat latar belakang dan pengalaman saya" currentPath="/about">
  <section class="border-b border-line bg-surface px-4 pb-8 pt-12 text-center sm:px-6">
    <div class="mx-auto w-full max-w-6xl">
      <h1 class="mb-3 text-4xl font-semibold sm:text-5xl">Tentang Saya</h1>
      <p class="mx-auto max-w-[600px] text-lg text-muted">Seorang developer yang senang membangun solusi digital yang bermakna</p>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[2fr_1fr]">
        <div>
          <h2 class="mb-4 text-2xl font-semibold sm:text-3xl">Hai, saya {site.name} 👋</h2>

          <p class="mb-5 leading-loose">
            Saya adalah seorang <strong class="font-semibold">Full Stack Developer</strong> dengan fokus pada pengembangan aplikasi web modern.
            Saya memiliki pengalaman membangun aplikasi dari konsep hingga deployment, menggunakan teknologi seperti
            <strong class="font-semibold">Astro, React, TypeScript, Node.js</strong>, dan database seperti <strong class="font-semibold">PostgreSQL</strong>.
          </p>

          <p class="mb-5 leading-loose">
            Saya percaya bahwa kode yang baik adalah kode yang <em>readable, maintainable, dan scalable</em>.
            Saya senang belajar teknologi baru, berbagi pengetahuan melalui tulisan, dan berkontribusi pada open source
            ketika memungkinkan.
          </p>

          <h3 class="mb-4 mt-8 text-xl font-semibold">Apa yang Saya Lakukan</h3>
          <ul class="flex flex-col gap-3" role="list">
            <li class="rounded-lg border border-line bg-surface p-4 leading-relaxed">
              <strong class="font-semibold">Web Development</strong> — Membangun aplikasi web responsif dan performant
            </li>
            <li class="rounded-lg border border-line bg-surface p-4 leading-relaxed">
              <strong class="font-semibold">API Design</strong> — Mendesain RESTful API dan GraphQL yang scalable
            </li>
            <li class="rounded-lg border border-line bg-surface p-4 leading-relaxed">
              <strong class="font-semibold">Database Design</strong> — Modeling data dan optimasi query PostgreSQL
            </li>
            <li class="rounded-lg border border-line bg-surface p-4 leading-relaxed">
              <strong class="font-semibold">DevOps Basics</strong> — CI/CD, Docker, dan deployment ke Vercel/AWS
            </li>
          </ul>
        </div>

        <aside class="flex flex-col gap-6">
          <div class="rounded-xl border border-line bg-surface p-6">
            <h3 class="mb-4 border-b border-line pb-3 text-base font-semibold">Keahlian</h3>
            <div class="grid gap-4">
              {skillCategories.map(category => (
                <div>
                  <h4 class="mb-2 text-[0.8125rem] font-semibold uppercase tracking-wider text-muted first:mt-0">{category}</h4>
                  <div class="flex flex-wrap gap-2" role="list" aria-label={`${category} skills`}>
                    {skills.filter(s => s.category === category).map(skill => (
                      <SkillTag name={skill.name} category={skill.category} level={skill.level} role="listitem" />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-xl border border-line bg-surface p-6">
            <h3 class="mb-4 border-b border-line pb-3 text-base font-semibold">Tools & Workflow</h3>
            <div class="flex flex-wrap gap-2">
              {['VS Code', 'Git & GitHub', 'Vercel', 'Docker', 'Postman', 'Figma', 'Notion', 'Linear'].map(tool => (
                <span class="rounded-full border border-line bg-bg px-3.5 py-1.5 text-[0.8125rem] font-medium text-muted transition-colors duration-200 hover:border-accent hover:text-accent">{tool}</span>
              ))}
            </div>
          </div>

          <div class="rounded-xl border border-line bg-surface p-6">
            <h3 class="mb-4 border-b border-line pb-3 text-base font-semibold">Saat Ini</h3>
            <ul class="flex flex-col" role="list">
              <li class="border-b border-line py-2 text-left text-[0.9375rem] last:border-b-0">🔭 Membangun project dengan Astro & React</li>
              <li class="border-b border-line py-2 text-left text-[0.9375rem] last:border-b-0">🌱 Mempelajari Rust & WebAssembly</li>
              <li class="border-b border-line py-2 text-left text-[0.9375rem] last:border-b-0">✍️ Menulis artikel teknis di blog ini</li>
              <li class="border-b border-line py-2 text-left text-[0.9375rem] last:border-b-0">💬 Terbuka untuk kolaborasi & freelance</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-surface py-20">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <header class="mb-12 text-center">
        <h2 class="text-3xl font-semibold sm:text-4xl">Pengalaman & Pendidikan</h2>
      </header>

      <div class="relative mx-auto max-w-[800px]">
        <div class="absolute bottom-0 left-3 top-0 w-0.5 bg-line md:left-6" aria-hidden="true"></div>

        {[
          {
            date: '2023 — Sekarang',
            title: 'Senior Frontend Developer',
            company: 'Tech Company',
            description: 'Memimpin pengembangan frontend untuk produk utama. Mengimplementasikan design system, migrasi ke TypeScript, dan mentoring junior developer.',
            tags: ['React', 'TypeScript', 'Next.js', 'Tailwind'],
          },
          {
            date: '2021 — 2023',
            title: 'Full Stack Developer',
            company: 'Digital Agency',
            description: 'Mengembangkan aplikasi web kustom untuk klien enterprise. Full cycle development dari requirement gathering hingga deployment dan maintenance.',
            tags: ['Node.js', 'PostgreSQL', 'Docker', 'AWS'],
          },
          {
            date: '2019 — 2021',
            title: 'S1 Informatika',
            company: 'Universitas Terkemuka',
            description: 'Fokus pada Software Engineering. Project akhir: E-commerce platform dengan microservices architecture. Cumlaude GPA 3.85/4.00.',
            tags: ['Java', 'Spring Boot', 'MySQL', 'Kubernetes'],
          },
        ].map(item => (
          <article class="relative flex gap-6 pb-12 last:pb-0">
            <div class="relative z-[1] flex h-12 w-12 shrink-0 items-center justify-center max-md:h-8">
              <span class="h-4 w-4 rounded-full bg-accent shadow-[0_0_0_2px_var(--color-accent)] ring-4 ring-bg max-md:h-3 max-md:w-3" aria-hidden="true"></span>
            </div>
            <div class="flex-1 pt-1">
              <time class="mb-1 block text-sm font-medium text-accent">{item.date}</time>
              <h3 class="mb-1 text-lg font-semibold">{item.title}</h3>
              <p class="mb-3 font-medium text-muted">{item.company}</p>
              <p class="mb-4 leading-relaxed">{item.description}</p>
              <div class="flex flex-wrap gap-2">
                {item.tags.map(tag => (
                  <span class="inline-block rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-[600px] px-4 text-center sm:px-6">
      <h2 class="text-3xl font-semibold sm:text-4xl">Tertarik Bekerja Sama?</h2>
      <p class="my-6 text-muted">
        Saya selalu terbuka untuk project menarik, kolaborasi open source, atau sekadar ngobrol soal teknologi.
      </p>
      <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition-colors duration-200 hover:bg-accent-hover motion-reduce:transition-none">Hubungi Saya</a>
    </div>
  </section>
</Layout>
