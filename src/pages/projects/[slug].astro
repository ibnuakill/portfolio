---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/helpers';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter(p => !p.data.draft)
    .map(project => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.data.title,
  description: project.data.description,
  url: project.data.demoUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
  keywords: project.data.tags.join(', '),
  datePublished: project.data.date.toISOString(),
  author: { '@type': 'Person', name: site.author },
};
---

<Layout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
  type="article"
  publishedTime={project.data.date.toISOString()}
  tags={project.data.tags}
  currentPath="/projects"
  canonicalURL={`${site.url}/projects/${project.id}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <article class="project-detail">
    <header class="project-header">
      <div class="container">
        <div class="project-meta">
          <time datetime={project.data.date.toISOString()} class="project-date">
            {formatDate(project.data.date)}
          </time>
          <div class="project-tags" role="list" aria-label="Teknologi">
            {project.data.tags.map(tag => <span class="tag" role="listitem">{tag}</span>)}
          </div>
        </div>
        <h1 class="project-title">{project.data.title}</h1>
        <p class="project-description">{project.data.description}</p>
        
        {project.data.demoUrl || project.data.repoUrl && (
          <div class="project-links-header">
            {project.data.demoUrl && (
              <a href={project.data.demoUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                Lihat Demo
              </a>
            )}
            {project.data.repoUrl && (
              <a href={project.data.repoUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                Lihat Kode
              </a>
            )}
          </div>
        )}
      </div>
    </header>
    
    {project.data.image && (
      <div class="project-image">
        <img src={project.data.image} alt="" loading="eager" />
      </div>
    )}
    
    <div class="project-content container">
      <div class="project-body">
        <Content />
      </div>
      
      <footer class="project-footer">
        <a href="/projects" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          Kembali ke Project
        </a>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .project-detail {
    padding-top: 0;
  }
  
  .project-header {
    padding: 4rem 0 2rem;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }
  
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .project-date {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }
  
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .project-title {
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .project-description {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 800px;
    margin-bottom: 2rem;
  }
  
  .project-links-header {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .project-image {
    margin: 0 calc(-1 * var(--container-padding));
    max-width: calc(100% + 2 * var(--container-padding));
  }
  
  .project-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .project-content {
    padding: 3rem var(--container-padding);
    max-width: var(--max-width);
    margin: 0 auto;
  }
  
  .project-body {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .project-body h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  
  .project-body h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  
  .project-body h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .project-body p {
    margin-bottom: 1.25rem;
  }
  
  .project-body ul, .project-body ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  
  .project-body li {
    margin-bottom: 0.5rem;
  }
  
  .project-body code {
    font-size: 0.9em;
  }
  
  .project-body pre {
    margin: 1.5rem 0;
    border-radius: var(--radius-md);
  }
  
  .project-body blockquote {
    border-left-color: var(--color-primary);
    margin: 1.5rem 0;
  }
  
  .project-body img {
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    box-shadow: var(--shadow-md);
  }
  
  .project-body a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .project-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    overflow-x: auto;
    display: block;
  }
  
  .project-body th, .project-body td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  
  .project-body th {
    background: var(--color-bg-secondary);
    font-weight: 600;
  }
  
  .project-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  
  @media (max-width: 768px) {
    .project-header {
      padding: 3rem 0 1.5rem;
    }
    
    .project-content {
      padding: 2rem var(--container-padding);
    }
    
    .project-image {
      margin: 0 calc(-1 * var(--container-padding));
    }
  }
</style>