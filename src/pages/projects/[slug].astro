---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/helpers';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter(p => !p.data.draft)
    .map(project => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.data.title,
  description: project.data.description,
  url: project.data.demoUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
  keywords: project.data.tags.join(', '),
  datePublished: project.data.date.toISOString(),
  author: { '@type': 'Person', name: site.author },
};

const btnPrimary = 'inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition-colors duration-200 hover:bg-accent-hover motion-reduce:transition-none';
const btnSecondary = 'inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-colors duration-200 hover:bg-line motion-reduce:transition-none';
---

<Layout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
  type="article"
  publishedTime={project.data.date.toISOString()}
  tags={project.data.tags}
  currentPath="/projects"
  canonicalURL={`${site.url}/projects/${project.id}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article>
    <header class="border-b border-line bg-surface px-4 pb-8 pt-12 sm:px-6 md:pt-16">
      <div class="mx-auto w-full max-w-6xl">
        <div class="mb-6 flex flex-wrap items-center gap-4">
          <time datetime={project.data.date.toISOString()} class="text-[0.9375rem] text-muted">
            {formatDate(project.data.date)}
          </time>
          <div class="flex flex-wrap gap-2" role="list" aria-label="Teknologi">
            {project.data.tags.map(tag => <span class="inline-block rounded-full border border-line bg-bg px-3 py-1 text-xs font-medium text-muted" role="listitem">{tag}</span>)}
          </div>
        </div>
        <h1 class="mb-4 text-3xl font-semibold leading-tight sm:text-5xl">{project.data.title}</h1>
        <p class="mb-8 max-w-[800px] text-xl text-muted">{project.data.description}</p>

        {project.data.demoUrl || project.data.repoUrl && (
          <div class="flex flex-wrap gap-4">
            {project.data.demoUrl && (
              <a href={project.data.demoUrl} class={btnPrimary} target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                Lihat Demo
              </a>
            )}
            {project.data.repoUrl && (
              <a href={project.data.repoUrl} class={btnSecondary} target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                Lihat Kode
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    {project.data.image && (
      <div>
        <img src={project.data.image} alt="" loading="eager" class="block h-auto w-full" />
      </div>
    )}

    <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 md:py-16">
      <div class="prose prose-invert prose-headings:font-semibold prose-h2:mt-12 prose-h2:border-t prose-h2:border-line prose-h2:pt-4 prose-h3:mt-8 prose-a:text-accent prose-a:underline prose-a:underline-offset-2 prose-code:rounded prose-code:bg-code prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-pre:border-line prose-pre:bg-code prose-pre:rounded-lg prose-blockquote:border-l-accent prose-img:rounded-lg prose-img:shadow-md prose-th:bg-surface prose-th:font-semibold prose-hr:border-line mx-auto max-w-[800px]">
        <Content />
      </div>

      <footer class="mt-16 border-t border-line pt-8 text-center">
        <a href="/projects" class={btnSecondary}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          Kembali ke Project
        </a>
      </footer>
    </div>
  </article>
</Layout>
