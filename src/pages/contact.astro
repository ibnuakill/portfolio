---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { social } from '../data/social';
---

<Layout title="Kontak" description="Hubungi saya untuk kolaborasi, project, atau pertanyaan" currentPath="/contact">
  <section class="border-b border-line bg-surface px-4 pb-8 pt-12 text-center sm:px-6">
    <div class="mx-auto w-full max-w-6xl">
      <h1 class="mb-3 text-4xl font-semibold sm:text-5xl">Hubungi Saya</h1>
      <p class="mx-auto max-w-[600px] text-lg text-muted">Punya project menarik? Butuh bantuan teknis? Atau sekadar mau ngobrol? Silakan kirim pesan.</p>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <h2 class="mb-4 text-2xl font-semibold sm:text-3xl">Mari Bicara</h2>
          <p class="mb-8 leading-loose text-muted">
            Saya selalu terbuka untuk diskusi tentang project baru, kolaborasi open source,
            peluang freelance, atau pertanyaan teknis. Jangan ragu untuk menghubungi.
          </p>

          <div class="mb-8 flex flex-col gap-4">
            <a href={social.email} class="flex items-center gap-4 rounded-lg border border-line bg-surface p-4 text-ink transition-[border-color,transform] duration-200 hover:translate-x-1 hover:border-accent motion-reduce:transition-none motion-reduce:hover:translate-x-0">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-accent text-white">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <span class="flex flex-col gap-0.5">
                <span class="text-[0.8125rem] font-medium uppercase tracking-wider text-muted">Email</span>
                <span class="font-medium">you@example.com</span>
              </span>
            </a>

            <a href={social.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-lg border border-line bg-surface p-4 text-ink transition-[border-color,transform] duration-200 hover:translate-x-1 hover:border-accent motion-reduce:transition-none motion-reduce:hover:translate-x-0">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-accent text-white">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
              </span>
              <span class="flex flex-col gap-0.5">
                <span class="text-[0.8125rem] font-medium uppercase tracking-wider text-muted">GitHub</span>
                <span class="font-medium">@yourusername</span>
              </span>
            </a>

            <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-lg border border-line bg-surface p-4 text-ink transition-[border-color,transform] duration-200 hover:translate-x-1 hover:border-accent motion-reduce:transition-none motion-reduce:hover:translate-x-0">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-accent text-white">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </span>
              <span class="flex flex-col gap-0.5">
                <span class="text-[0.8125rem] font-medium uppercase tracking-wider text-muted">LinkedIn</span>
                <span class="font-medium">/in/yourusername</span>
              </span>
            </a>
          </div>

          <div class="flex items-start gap-3 rounded-lg border border-accent/15 bg-accent/5 p-4 text-[0.9375rem] leading-relaxed text-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="mt-0.5 shrink-0">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <p>Biasanya saya balas dalam 1-2 hari kerja. Untuk urgensi, sebutkan di subjek pesan.</p>
          </div>
        </div>

        <div>
          <div class="rounded-xl border border-line bg-surface p-6 lg:sticky lg:top-24 max-lg:p-6">
            <h2 class="mb-6 text-2xl font-semibold">Kirim Pesan</h2>
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
