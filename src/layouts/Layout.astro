---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  currentPath?: string;
  canonicalURL?: string;
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  currentPath = '/',
  canonicalURL = site.url,
} = Astro.props;

const pageTitle = title === site.name ? site.title : `${title} — ${site.name}`;
const pageDescription = description || site.description;
const pageImage = image.startsWith('http') ? image : `${site.url}${image}`;
const pageURL = canonicalURL.startsWith('http') ? canonicalURL : `${site.url}${canonicalURL}`;
---

<!doctype html>
<html lang="id" data-theme="dark" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={pageURL} />
    
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0a0a0a" />
    
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:site_name" content={site.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />
    
    {type === 'article' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: pageDescription,
        image: pageImage,
        url: pageURL,
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        author: { '@type': 'Person', name: site.author },
        publisher: { '@type': 'Organization', name: site.name },
        keywords: tags.join(', '),
      })} />
    )}
  </head>
  <body class="flex flex-col min-h-screen bg-bg font-sans text-ink leading-relaxed antialiased">
    <a href="#main-content" class="absolute left-1/2 -top-24 z-[10000] -translate-x-1/2 rounded-lg bg-accent px-6 py-3 text-white transition-[top] duration-200 focus:top-4">Skip to main content</a>
    
    <Header currentPath={currentPath} />
    
    <main id="main-content" role="main" class="flex-1">
      <slot />
    </main>
    
    <Footer />
    
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
    </script>
    <script defer src="/_vercel/insights/script.js" is:inline></script>
  </body>
</html>
