---
interface Props {
  name: string;
  category: string;
  level?: string;
}
const { name, category, level } = Astro.props;
---

<span class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors duration-200 hover:border-accent hover:text-accent" data-category={category}>
  {name}
  {level && <span class="rounded-full bg-accent px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wide text-white">{level}</span>}
</span>
