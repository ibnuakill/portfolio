---
interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  tags: string[];
  slug: string;
  draft?: boolean;
  readingTime?: number;
}
const { title, description, pubDate, tags, slug, draft = false, readingTime } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="blog-card card">
  <div class="blog-content">
    {draft && <span class="blog-badge">Draft</span>}
    
    <div class="blog-meta">
      <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
      {readingTime && <span class="reading-time">· {readingTime} min baca</span>}
    </div>
    
    <h3 class="blog-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>
    
    <p class="blog-description">{description}</p>
    
    <div class="blog-tags" role="list" aria-label="Tag">
      {tags.map(tag => (
        <a href={`/blog?tag=${tag}`} class="tag" role="listitem">{tag}</a>
      ))}
    </div>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  
  .blog-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }
  
  .blog-badge {
    align-self: flex-start;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--color-border);
    color: var(--color-text-secondary);
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }
  
  .blog-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  
  .blog-title a {
    color: var(--color-text);
    transition: color var(--transition);
  }
  
  .blog-title a:hover {
    color: var(--color-primary);
  }
  
  .blog-description {
    flex: 1;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .blog-tags .tag {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: transparent;
  }
  
  .blog-tags .tag:hover {
    background: var(--color-primary);
    color: white;
  }
</style>