---
interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  tags: string[];
  slug: string;
  draft?: boolean;
  readingTime?: number;
}
const { title, description, pubDate, tags, slug, draft = false, readingTime } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="flex h-full flex-col overflow-hidden rounded-xl border border-line bg-bg transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-accent hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:translate-y-0">
  <div class="flex flex-1 flex-col p-6">
    {draft && <span class="mb-3 self-start rounded-full bg-line px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-muted">Draft</span>}

    <div class="mb-2 flex items-center gap-3 text-[0.8125rem] text-muted">
      <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
      {readingTime && <span>· {readingTime} min baca</span>}
    </div>

    <h3 class="mb-3 text-xl font-semibold leading-snug">
      <a href={`/blog/${slug}`} class="text-ink transition-colors duration-200 hover:text-accent">{title}</a>
    </h3>

    <p class="mb-4 flex-1 text-[0.9375rem] leading-relaxed text-muted">{description}</p>

    <div class="flex flex-wrap gap-2" role="list" aria-label="Tag">
      {tags.map(tag => (
        <a href={`/blog?tag=${tag}`} class="inline-block rounded-full border border-accent bg-transparent px-3 py-1 text-xs font-medium text-accent transition-colors duration-200 hover:bg-accent hover:text-white" role="listitem">{tag}</a>
      ))}
    </div>
  </div>
</article>
