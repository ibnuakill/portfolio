---
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  demoUrl?: string;
  repoUrl?: string;
  featured?: boolean;
}
const { title, description, image, tags, demoUrl, repoUrl, featured = false } = Astro.props;
---

<article class="group relative w-full overflow-hidden rounded-xl bg-gradient-to-br from-slate-900/90 to-slate-800/90 backdrop-blur-lg border border-white/10 shadow-2xl transition-all duration-300 hover:shadow-[#068e75]/20 hover:border-[#068e75]/50 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0" data-aos="fade-up" data-aos-duration="1000">
  <div class="absolute inset-0 bg-gradient-to-br from-[#068e75]/10 via-[#10b981]/10 to-white/5 opacity-50 group-hover:opacity-70 transition-opacity duration-300 pointer-events-none"></div>
  <div class="absolute inset-0 border border-white/0 group-hover:border-[#068e75]/40 rounded-xl transition-colors duration-300 pointer-events-none"></div>
  <div class="relative p-5 z-10 flex h-full flex-col">
    <div class="relative overflow-hidden rounded-lg aspect-video bg-black/20">
      <img src={image} alt="" loading="lazy" width="400" height="225" class="h-full w-full object-cover transform group-hover:scale-105 transition-transform duration-500 motion-reduce:group-hover:scale-100" />
      {featured && <span class="absolute right-3 top-3 rounded-full bg-[#068e75] px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-white">Unggulan</span>}
      <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-transparent opacity-0 group-hover:opacity-100 -translate-x-full group-hover:translate-x-full transition-all duration-700 pointer-events-none"></div>
    </div>
    <div class="mt-4 flex flex-1 flex-col">
      <h3 class="mb-2 text-lg font-semibold bg-gradient-to-r from-white via-blue-100 to-blue-200 bg-clip-text text-transparent">{title}</h3>
      <p class="mb-4 flex-1 text-[0.9375rem] leading-relaxed text-white/70 line-clamp-2">{description}</p>
      <div class="mb-5 flex flex-wrap gap-2" role="list" aria-label="Teknologi">
        {tags.map(tag => <span class="inline-block rounded-full border border-white/10 bg-white/5 backdrop-blur-sm px-3 py-1 text-xs font-medium text-white/70 group-hover:bg-white/10 group-hover:text-white transition-colors" role="listitem">{tag}</span>)}
      </div>
      <div class="flex gap-3">
        {demoUrl && (
          <a href={demoUrl} class="project-lottie-btn group/btn relative inline-flex items-center justify-center gap-2 rounded-lg bg-[#068e75] px-5 py-2.5 text-sm font-medium text-white overflow-hidden hover:bg-[#068e75]/90 transition-colors" target="_blank" rel="noopener noreferrer">
            <span class="absolute inset-0 scale-x-0 group-hover/btn:scale-x-100 origin-left bg-white/10 transition-transform duration-500"></span>
            <span class="relative flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              Demo
            </span>
          </a>
        )}
        {repoUrl && (
          <a href={repoUrl} class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 px-5 py-2.5 text-sm font-medium text-white/90 transition-all hover:scale-105 active:scale-95" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            Kode
          </a>
        )}
      </div>
    </div>
  </div>
</article>
<script>
  import AOS from "aos"
  if (typeof window !== "undefined") AOS.init({ once: false, offset: 10 })
</script>
